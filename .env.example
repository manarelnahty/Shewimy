# ==============================================================================
# Al Shewimy - Platform Environment Configuration Template (.env.example)
# Official Technical Specification | Firebase Firestore & Next.js 14+
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Web App Configuration (DRD Section 1, 7 & 8)
# How to get these:
# 1. Go to https://console.firebase.google.com/
# 2. Select your project (or create one named "shewimy-app")
# 3. Go to Project Settings (gear icon) -> General -> "Your apps"
# 4. Click the Web icon (</>) to register a web app and copy the config values
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourActualApiKeyHere123456789"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="shewimy-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://shewimy-app-default-rtdb.firebaseio.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="shewimy-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="shewimy-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 2. Super Admin Credentials (DRD Admin Portal & Security)
# Used for initial super admin authentication, provisioning, and dashboard access
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="admin@shewimy.com"
SUPER_ADMIN_PASSWORD="YourSecurePasswordHere2026!"
NEXT_PUBLIC_ADMIN_EMAIL="admin@shewimy.com"

# ------------------------------------------------------------------------------
# 3. Platform Canonical Domain (DRD Section 5)
# Used in WhatsApp dynamic deep-links: https://shewimy.com/catalog/${section}/${slug}
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://shewimy.com"

# ------------------------------------------------------------------------------
# 4. Branch WhatsApp Routing Engine Configuration (DRD Section 4 & 5)
# Numbers must be in international format without '+' or spaces (e.g. 201005557109)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_MANSOURA="201005557109"
NEXT_PUBLIC_WHATSAPP_MAHALLA="201287153339"
NEXT_PUBLIC_WHATSAPP_SAMANOUD="201287153339"
