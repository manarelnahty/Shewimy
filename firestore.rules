rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. السماح بالقراءة العامة للمنتجات المنشورة والفروع المعتمدة
    match /items/{itemId} {
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null; // الأدمن فقط
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. السماح للزوار بتقديم طلبات المعاينة دون صلاحية قراءة طلبات الآخرين
    match /inspection_requests/{requestId} {
      allow create: if request.resource.data.phoneNumber != null && request.resource.data.clientName != null;
      allow read, update, delete: if request.auth != null;
    }
  }
}
